    "starred_url": "https://api.github.com/users/tmvn/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/tmvn/subscriptions",
    "organizations_url": "https://api.github.com/users/tmvn/orgs",
    "repos_url": "https://api.github.com/users/tmvn/repos",
    "events_url": "https://api.github.com/users/tmvn/events{/privacy}",
