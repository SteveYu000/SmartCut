  "title": "Frame-accurate smart copy: trim without re-encoding the interior",
  "user": {
    "login": "tmvn",
    "id": 3411415,
    "node_id": "MDQ6VXNlcjM0MTE0MTU=",
    "avatar_url": "https://avatars.githubusercontent.com/u/3411415?v=4",
